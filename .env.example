APP_ENV=local
APP_URL=http://localhost:8080

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ordina
DB_USERNAME=ordina
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# Dedicated credentials for tests/Integration (TEST-02), scoped to their own
# database so integration tests never touch dev/demo data. Provisioned by
# database/test-db-init.sql - see README "Tests & static analysis".
DB_TEST_HOST=mysql
DB_TEST_PORT=3306
DB_TEST_DATABASE=ordina_test
DB_TEST_USERNAME=tester
DB_TEST_PASSWORD=testing123

SESSION_DRIVER=file
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
