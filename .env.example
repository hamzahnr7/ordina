APP_ENV=local
APP_URL=http://localhost:8080

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ordina
DB_USERNAME=ordina
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# Test database used by tests/Integration (a separate schema on the same MySQL server)
DB_TEST_DATABASE=ordina_test

SESSION_DRIVER=file
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
